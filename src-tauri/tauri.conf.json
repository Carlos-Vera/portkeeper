{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Portkeeper",
  "version": "0.3.0",
  "identifier": "dev.maparisi.portkeeper",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Portkeeper",
        "width": 280,
        "height": 120,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Open ports and Docker containers at a glance",
    "longDescription": "Portkeeper is a small desktop widget that shows every TCP port listening on your machine, which IDE or AI agent started it, and your Docker containers. Open them in the browser, stop containers or kill processes with one click.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
